{
  "name": "dsh-oil-sticky-prompt",
  "version": "0.2.0",
  "description": "Pin the nearest user prompt to the top of a DeepSeek Harness transcript",
  "license": "MIT",
  "author": "oil-oil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oil-oil/dsh-oil-sticky-prompt.git"
  },
  "homepage": "https://github.com/oil-oil/dsh-oil-sticky-prompt#readme",
  "bugs": {
    "url": "https://github.com/oil-oil/dsh-oil-sticky-prompt/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis"
  ],
  "packageManager": "pnpm@10.16.1",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
